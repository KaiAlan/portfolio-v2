# ---- Contentful ----
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
# Content Delivery API — read-only, safe on the server. Never NEXT_PUBLIC_.
CONTENTFUL_DELIVERY_TOKEN=
# Content Management API — write. SERVER ONLY. Never NEXT_PUBLIC_.
CONTENTFUL_MANAGEMENT_TOKEN=

# ---- Cloudflare R2 (video + upload staging) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Custom domain — r2.dev is rate-limited and unusable in production.
NEXT_PUBLIC_CDN_URL=https://cdn.kaialan.com

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://kaialan.com

# ---- Studio (/admin) ----
# Same Contentful API key as delivery; use its Preview token.
CONTENTFUL_PREVIEW_TOKEN=
# Studio login. Local only for now — password + TOTP before this is ever public.
ADMIN_PASSWORD=
# iron-session cookie encryption, >= 32 characters.
SESSION_SECRET=
